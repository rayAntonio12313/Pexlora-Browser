{
  "name": "pexlora-browser",
  "productName": "Pexlora Browser",
  "version": "0.1.1",
  "description": "Pexlora Browser — navegador desktop experimental",
  "author": "Pexlora",
  "license": "UNLICENSED",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.js && node --check preload.js && node --check src/renderer.js",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "dist:win:portable": "electron-builder --win portable --x64 --publish never",
    "dist:win:all": "electron-builder --win nsis portable --x64 --publish never",
    "dist:linux": "electron-builder --linux AppImage --x64 --publish never"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.1"
  },
  "build": {
    "appId": "com.pexlora.browser",
    "productName": "Pexlora Browser",
    "executableName": "Pexlora",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "package.json",
      "assets/pexlora-owl.webp",
      "assets/pexlora-owl.ico"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pexlora Browser",
      "uninstallDisplayName": "Pexlora Browser",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Pexlora-Setup-${version}.${ext}",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "runAfterFinish": true,
      "menuCategory": "Pexlora Browser"
    },
    "portable": {
      "artifactName": "Pexlora-Portable-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Network;WebBrowser",
      "artifactName": "Pexlora-${version}.${ext}"
    }
  }
}
